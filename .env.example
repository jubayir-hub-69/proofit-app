# Server-only Alchemy RPC key. Used by API routes. Never prefix with NEXT_PUBLIC_.
# Browser wallet transports use each chain's public RPC.
ALCHEMY_API_KEY=

# GoldRush (Covalent) key for wallet history.
# Sent as Authorization: Bearer. The NEXT_PUBLIC_ prefix exposes it to the browser.
NEXT_PUBLIC_COVALENT_API_KEY=

# Server-only GoPlus app credentials. API routes sign an access token.
# Never prefix these with NEXT_PUBLIC_.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# Server-only. Telegram bot token for later alerts. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Server-only. Postgres connection string. Apply supabase/schema.sql before use.
DATABASE_URL=

# Server-only Supabase REST credentials for the sync and ledger routes.
# When both are empty, those routes keep the book in memory and serve sample rows.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
